# ============================================================
# GeoVisio 上傳系統 - 環境變數設定範本
# ============================================================
# 版本: 3.0.0
# 更新日期: 2026-05-12
#
# 使用方式:
#   1. 複製此檔案為 .env
#   2. 填入下方「必填」項目
#   3. 執行 python -m src.main
#
# 大部分調校參數（速度、批次、重試等）已移至 config.toml，
# 無需在此設定。若需覆蓋 config.toml 的值，
# 可取消下方「選用覆蓋」區塊的註解。
# ============================================================

# ============================================================
# 必填設定
# ============================================================

# GeoVisio API 位址
TMS_GEOVISIO_URL=http://your-server-ip:5001

# CSV 資料夾路徑（程式自動掃描資料夾內所有 .csv，依檔名排序）
CSV_FOLDER_PATH=/path/to/your/csv_folder

# 影像檔案根目錄
IMAGE_BASE_PATH=/path/to/your/images

# PostgreSQL 連線字串（用於去重、資源監控、續傳）
DATABASE_URL=postgresql://username:password@your-server-ip:5432/geovisio

# 車輛類型（影響序列分割閾值）
#   CAR:        時間閾值 500秒，距離閾值 200公尺
#   MOTORCYCLE: 時間閾值 300秒，距離閾值 20公尺
VEHICLE_TYPE=CAR

# 專案名稱
PROJECT_NAME=your_project_name

# ============================================================
# 認證設定
# ============================================================
ENABLE_AUTH=true
# GeoVisio 內部 JWT Token（由資料庫 tokens 表 + FLASK_SECRET_KEY 產生）
# 產生方式請參考 README.md 的「認證機制」章節
GEOVISIO_API_TOKEN=your_generated_token_here

# Docker 容器監控主機自動採用 TMS_GEOVISIO_URL 的主機位址，不需另外設定

# Discord 通知（選用，兩個都設定才會啟用）
# DISCORD_BOT_TOKEN=your_bot_token_here
# DISCORD_CHANNEL_ID=your_channel_id_here

# ============================================================
# 日期過濾（選用）
# ============================================================
# 僅處理指定日期（格式: YYYY-MM-DD，逗號分隔；設定後忽略 CUTOFF_DATE）
# SPECIFIED_DATES=2025-08-29,2025-08-30,2025-09-01

# 跳過早於此日期的資料（格式: YYYY-MM-DD）
# CUTOFF_DATE=2025-05-01

# 單檔模式（向下相容，CSV_FOLDER_PATH 優先）
# CSV_FILE_PATH=/path/to/your/data.csv

# ============================================================
# 選用覆蓋：config.toml 預設值
# ============================================================
# 如需覆蓋 config.toml 任何參數，用相同的環境變數名稱設定在此即可，
# 例如 MAX_CONCURRENT_UPLOADS=15。完整參數清單請見 config.toml。
