# ========================================
# GeoVisio 上傳系統環境變數設定
# ========================================
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# ========================================
# API 設定
# ========================================
TMS_GEOVISIO_URL=http://192.168.61.3:5001

# ========================================
# 檔案路徑設定
# ========================================
CSV_FILE_PATH=D:\path\to\your\data.csv
IMAGE_BASE_PATH=D:\path\to\your\images

# ========================================
# 資料庫設定 (用於去重檢查和資源監控)
# ========================================
DATABASE_URL=postgresql://user:password@192.168.61.3:5432/geovisio

# ========================================
# 上傳核心參數 (影響速度的關鍵參數)
# ========================================
# 最大並發上傳數
# - 保守值: 5 (適合網路不穩定或 API 負載高時)
# - 建議值: 10-15 (API 使用 Gunicorn 後)
# - 激進值: 20 (網路和 API 都很穩定時)
MAX_CONCURRENT_UPLOADS=10

# 單張圖片上傳超時時間 (秒)
UPLOAD_TIMEOUT=60

# 序列間延遲 (秒) - 同一天內不同序列的間隔
SEQUENCE_DELAY=2

# 日期組間延遲 (秒) - 不同日期間的間隔
# - 原始值: 300 (5分鐘，非常保守)
# - 建議值: 60-120 (1-2分鐘)
# - 激進值: 30 (高速模式)
BATCH_DELAY=60

# ========================================
# 連線池設定
# ========================================
# aiohttp 連線池大小，應 >= MAX_CONCURRENT_UPLOADS
MAX_POOL_SIZE=20

# ========================================
# 批次處理策略
# ========================================
# 序列大小分類閾值
SEQUENCE_SMALL_THRESHOLD=500
SEQUENCE_MEDIUM_THRESHOLD=2000

# 小型序列配置 (< 500 張)
BATCH_SIZE_SMALL=100
BATCH_DELAY_SMALL=5
CONCURRENT_SMALL=5

# 中型序列配置 (500-2000 張)
BATCH_SIZE_MEDIUM=50
BATCH_DELAY_MEDIUM=10
CONCURRENT_MEDIUM=3

# 大型序列配置 (> 2000 張)
BATCH_SIZE_LARGE=30
BATCH_DELAY_LARGE=15
CONCURRENT_LARGE=2

# ========================================
# 資源監控閾值 (基於 Job Queue)
# ========================================
# Job Queue 積壓數量 < 此值時全速運行
JOB_QUEUE_SAFE_THRESHOLD=200

# Job Queue 積壓數量 >= 此值時減速
JOB_QUEUE_WARNING_THRESHOLD=1000

# 資源狀態檢查間隔 (秒)
RESOURCE_CHECK_INTERVAL=60

# ========================================
# 去重檢查設定
# ========================================
# KeyName/MD5 快取的最大數量
DEDUP_MAX_CACHE_SIZE=100000

# 啟動時預載入的快取數量
DEDUP_PRELOAD_LIMIT=50000

# ========================================
# 功能開關
# ========================================
# 是否啟用去重檢查 (true/false)
ENABLE_DEDUPLICATION=true

# 是否啟用 MD5 檢查 (true/false)
# 關閉可加快速度，但可能上傳內容相同但檔名不同的圖片
ENABLE_MD5_CHECK=true

# 是否啟用資源監控 (true/false)
ENABLE_RESOURCE_MONITOR=true

# ========================================
# 資料預處理設定
# ========================================
# 車輛類型: CAR 或 MOTORCYCLE
# CAR: 時間閾值 500秒, 距離閾值 200公尺
# MOTORCYCLE: 時間閾值 300秒, 距離閾值 20公尺
VEHICLE_TYPE=CAR

# 截止日期 - 跳過早於此日期的資料 (格式: YYYY-MM-DD)
CUTOFF_DATE=2025-06-01

# ========================================
# 連線與超時設定 (新增)
# ========================================
# DNS 快取時間 (秒)
DNS_CACHE_TTL=300

# 連線建立超時 (秒)
CONNECT_TIMEOUT=10

# 讀取回應超時 (秒)
READ_TIMEOUT=60

# ========================================
# 重試設定 (新增)
# ========================================
# 上傳失敗重試次數
RETRY_ATTEMPTS=3

# 重試間隔 (秒)
RETRY_DELAY=2

# ========================================
# 去重失敗行為 (新增)
# ========================================
# continue = 去重檢查失敗時繼續上傳
# skip = 去重檢查失敗時跳過（更保守）
DEDUP_FAILURE_BEHAVIOR=continue


# ========================================
# 速度優化建議
# ========================================
# 🚀 高速模式 (網路和 API 都穩定時):
#    MAX_CONCURRENT_UPLOADS=20
#    BATCH_DELAY=30
#    SEQUENCE_DELAY=1
#    BATCH_SIZE_SMALL=150
#    BATCH_SIZE_MEDIUM=80
#    BATCH_SIZE_LARGE=50
#
# 🐢 保守模式 (API 負載高或網路不穩定時):
#    MAX_CONCURRENT_UPLOADS=3
#    BATCH_DELAY=300
#    SEQUENCE_DELAY=5
#    BATCH_SIZE_SMALL=30
#    BATCH_SIZE_MEDIUM=20
#    BATCH_SIZE_LARGE=10
