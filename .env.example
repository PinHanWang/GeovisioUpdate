# ========================================
# GeoVisio 上傳系統 - 環境變數設定範本
# ========================================
# 版本: 2.1.0
# 更新日期: 2026-02-11
#
# 使用方式:
#   1. 複製此檔案為 .env
#   2. 填入實際的設定值
#   3. 執行 python -m src.main
# ========================================

# ========================================
# 🔗 API 設定 (必要)
# ========================================
TMS_GEOVISIO_URL=http://your-server-ip:5001

# ========================================
# 📁 檔案路徑設定 (必要)
# ========================================
# CSV 資料夾路徑 (程式會自動掃描資料夾內所有 .csv 檔案，依檔名排序依序處理)
# 所有 CSV 共用同一個 IMAGE_BASE_PATH
CSV_FOLDER_PATH=/path/to/your/csv_folder

# 影像檔案根目錄
IMAGE_BASE_PATH=/path/to/your/images

# 單檔模式 (向下相容，CSV_FOLDER_PATH 優先；兩者至少設定一個)
# CSV_FILE_PATH=/path/to/your/data.csv

# ========================================
# 🔐 GeoVisio API 認證設定
# ========================================
ENABLE_AUTH=true
# GeoVisio 內部 JWT Token (由資料庫 tokens 表 + FLASK_SECRET_KEY 產生)
# 產生方式請參考 README.md 的「認證機制」章節
# 此 token 與 Keycloak 無關，只要 FLASK_SECRET_KEY 和資料庫不變就永久有效
GEOVISIO_API_TOKEN=your_generated_token_here

# ========================================
# 🗄️ 資料庫設定 (必要)
# ========================================
# 用於去重檢查、資源監控、續傳功能
DATABASE_URL=postgresql://username:password@your-server-ip:5432/geovisio

# ========================================
# ⚡ 上傳核心參數
# ========================================
# 最大並發上傳數
#   保守: 5  | 建議: 10-15 | 激進: 20
MAX_CONCURRENT_UPLOADS=10

# 單張圖片上傳超時 (秒)
UPLOAD_TIMEOUT=60

# 序列間延遲 (秒) - 同一天內不同序列的間隔
SEQUENCE_DELAY=2

# 日期組間延遲 (秒) - 不同日期間的間隔 (也用於 CSV 間延遲)
#   保守: 300 | 建議: 60-120 | 激進: 30
BATCH_DELAY=120

# ========================================
# 🔌 連線池設定
# ========================================
# aiohttp 連線池大小 (應 >= MAX_CONCURRENT_UPLOADS)
MAX_POOL_SIZE=20

# DNS 快取時間 (秒)
DNS_CACHE_TTL=300

# 連線建立超時 (秒)
CONNECT_TIMEOUT=10

# 讀取回應超時 (秒)
READ_TIMEOUT=60

# Keep-Alive 超時 (秒)
KEEPALIVE_TIMEOUT=30

# ========================================
# 🔄 重試設定
# ========================================
# 上傳失敗重試次數
RETRY_ATTEMPTS=3

# 重試最小等待時間 (秒)
RETRY_MIN_WAIT=1

# 重試最大等待時間 (秒)
RETRY_MAX_WAIT=30

# 重試間隔 (秒) - 向後相容
RETRY_DELAY=2

# ========================================
# 📦 批次處理策略
# ========================================
# 序列大小分類閾值
SEQUENCE_SMALL_THRESHOLD=500
SEQUENCE_MEDIUM_THRESHOLD=2000

# 小型序列配置 (< 500 張)
BATCH_SIZE_SMALL=100
BATCH_DELAY_SMALL=5
CONCURRENT_SMALL=5

# 中型序列配置 (500-2000 張)
BATCH_SIZE_MEDIUM=50
BATCH_DELAY_MEDIUM=10
CONCURRENT_MEDIUM=3

# 大型序列配置 (> 2000 張)
BATCH_SIZE_LARGE=30
BATCH_DELAY_LARGE=15
CONCURRENT_LARGE=2

# ========================================
# 📊 資源監控閾值 (基於 Job Queue)
# ========================================
# Job Queue 積壓數量 < 此值時全速運行
JOB_QUEUE_SAFE_THRESHOLD=200

# Job Queue 積壓數量 >= 此值時減速
JOB_QUEUE_WARNING_THRESHOLD=1000

# 資源狀態檢查間隔 (秒)
RESOURCE_CHECK_INTERVAL=60

# ========================================
# 🔍 去重檢查設定
# ========================================
# KeyName/MD5 快取的最大數量
DEDUP_MAX_CACHE_SIZE=100000

# 啟動時預載入的快取數量
DEDUP_PRELOAD_LIMIT=50000

# 去重失敗行為
#   continue = 去重檢查失敗時繼續上傳
#   skip     = 去重檢查失敗時跳過 (更保守)
DEDUP_FAILURE_BEHAVIOR=continue

# ========================================
# 🎛️ 功能開關
# ========================================
# 是否啟用去重檢查
ENABLE_DEDUPLICATION=true

# 是否啟用 MD5 檢查 (關閉可加快速度)
ENABLE_MD5_CHECK=true

# 是否啟用資源監控
ENABLE_RESOURCE_MONITOR=true

# ========================================
# 🚗 資料預處理設定
# ========================================
# 車輛類型: CAR 或 MOTORCYCLE
#   CAR:        時間閾值 500秒, 距離閾值 200公尺
#   MOTORCYCLE: 時間閾值 300秒, 距離閾值 20公尺
VEHICLE_TYPE= 'CAR'

# 指定處理日期 (僅處理這些日期，格式: YYYY-MM-DD，逗號分隔)
# SPECIFIED_DATES=2025-08-29,2025-08-30,2025-09-01

# 截止日期 (跳過早於此日期的資料)
# CUTOFF_DATE=2025-05-01

# ========================================
# 🐳 Docker 容器監控 (選用)
# ========================================
DOCKER_TARGET_IP=your-server-ip
DOCKER_CONTAINER_NAME=your-container-name
HAWSER_PORT=2375

# 記憶體告警門檻 (MB)
MONITOR_MEM_THRESHOLD_MB=3072 # 3GB

# 監控回報頻率 (秒)
MONITOR_INTERVAL=300

# ========================================
# 🤖 Discord 通知 (選用)
# ========================================
# DISCORD_BOT_TOKEN=your_bot_token_here
# DISCORD_CHANNEL_ID=your_channel_id_here

# ========================================
# 🚀 速度優化預設組合
# ========================================
#
# 【高速模式】適用於網路和 API 都穩定時
# ----------------------------------------
# MAX_CONCURRENT_UPLOADS=20
# BATCH_DELAY=30
# SEQUENCE_DELAY=1
# BATCH_SIZE_SMALL=150
# BATCH_SIZE_MEDIUM=80
# BATCH_SIZE_LARGE=50
#
# 【標準模式】適用於一般情況 (預設)
# ----------------------------------------
# MAX_CONCURRENT_UPLOADS=10
# BATCH_DELAY=120
# SEQUENCE_DELAY=2
# BATCH_SIZE_SMALL=100
# BATCH_SIZE_MEDIUM=50
# BATCH_SIZE_LARGE=30
#
# 【保守模式】適用於 API 負載高或網路不穩定時
# ----------------------------------------
# MAX_CONCURRENT_UPLOADS=3
# BATCH_DELAY=300
# SEQUENCE_DELAY=5
# BATCH_SIZE_SMALL=30
# BATCH_SIZE_MEDIUM=20
# BATCH_SIZE_LARGE=10
