## GeoVisio API configuration
# TMS local server
TMS_GEOVISIO_URL=YOUR_GEOVISIO_URL_LOCAL
# TWCC cloud server
TWCC_GEOVISIO_URL=YOUR_GEOVISIO_URL_CLOUD

## Collection record path
CSV_FILE_PATH=PATH_TO_YOUR_CSV_FILE.csv

## Image storage path
# Base path for storing images
IMAGE_BASE_PATH=PATH_TO_YOUR_IMAGES

## Upload configuration
# Maximum number of concurrent uploads at once
MAX_CONCURRENT_UPLOADS=5
# Timeout for each upload request in seconds
UPLOAD_TIMEOUT=60
# Sequence Delay
SEQUENCE_DELAY=3
# Batch delay
BATCH_DELAY=300

## Data preprocessing configuration
VEHICLE_TYPE=CAR  # 'CAR' or 'MOTORCYCLE'

## Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual configuration:
#    - Set appropriate GeoVisio server URLs (local TMS or TWCC cloud)
#    - Update file paths to match your system
#    - Adjust upload parameters based on your network conditions
#    - Choose VEHICLE_TYPE based on your data type:
#      * CAR: For 10+ meter wide road data (500s time threshold, 200m distance threshold)
#      * MOTORCYCLE: For sidewalk/narrow road data (300s time threshold, 20m distance threshold)
# 3. Ensure all file paths exist and are accessible
# 4. Test connectivity to your chosen GeoVisio server
